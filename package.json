{
  "name": "wave-field",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "engine:build": "node scripts/build-rust-engine.mjs",
    "engine:bench": "node scripts/bench-rust-engine.mjs",
    "dev": "npm run engine:build && vite --host 127.0.0.1",
    "arena": "npm run engine:build && vite --host 127.0.0.1 --mode arena",
    "analyze:mechanics": "node scripts/analyze-mechanics.mjs",
    "analyze:heuristic": "node scripts/eval-heuristic-configs.mjs",
    "selfplay:mine": "node scripts/selfplay-position-miner.mjs",
    "selfplay:analyze": "node scripts/analyze-selfplay.mjs",
    "selfplay:decisiveness": "node scripts/probe-decisiveness.mjs",
    "selfplay:hard-study": "node scripts/study-hard-converter.mjs",
    "selfplay:hard-sweep": "node scripts/sweep-hard-params.mjs",
    "search:optim": "node scripts/search-optim-configs.mjs",
    "build": "npm run engine:build && tsc && vite build && node scripts/copy-arena-entry.mjs && node scripts/create-sites-worker.mjs",
    "test": "cargo build --manifest-path engine/Cargo.toml && vitest run",
    "test:watch": "cargo build --manifest-path engine/Cargo.toml && vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "4.0.15"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
